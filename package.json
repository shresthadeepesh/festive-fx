{
  "name": "festive-fx",
  "version": "0.2.0",
  "description": "Framework-agnostic festive overlay effects: snow, rain with splashes, Tihar/Diwali rockets, confetti, falling leaves. Works with React, Vue, Angular, Svelte or plain HTML.",
  "license": "MIT",
  "author": "Dipesh Shrestha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shresthadeepesh/festive-fx.git"
  },
  "homepage": "https://shresthadeepesh.github.io/festive-fx/",
  "bugs": {
    "url": "https://github.com/shresthadeepesh/festive-fx/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs",
    "./dist/festive-fx.iife.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/festive-fx.iife.js",
  "jsdelivr": "./dist/festive-fx.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "site": "npm run build && rm -rf _site && mkdir -p _site && cp -R site/. _site/ && cp dist/festive-fx.iife.js _site/ && touch _site/.nojekyll"
  },
  "keywords": [
    "snow",
    "snowfall",
    "rain",
    "fireworks",
    "diwali",
    "deepawali",
    "tihar",
    "confetti",
    "particles",
    "canvas",
    "overlay",
    "web-component",
    "react",
    "vue",
    "angular"
  ],
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "vue": "^3.5.13"
  }
}
